_zfz() {
  cd $(z | awk '{ print $2 }' | fzf --reverse)
}

_zhz() {
  ssh $(grep -E "^Host " ~/.ssh/config | grep -v "*" | sed -e 's/Host[ ]*//g' | fzf)
}

if type brew &>/dev/null; then
  alias ls='gls --color'
  HOMEBREW_PREFIX="$(brew --prefix)"

  source ${HOMEBREW_PREFIX}/etc/bash_completion.d/git-completion.bash
  source ${HOMEBREW_PREFIX}/etc/profile.d/z.sh
  source ${HOMEBREW_PREFIX}/etc/bash_completion.d/git-prompt.sh
  eval "$(${HOMEBREW_PREFIX}/bin/brew shellenv)"
  if [[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]]; then
    source "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"
  else
    for COMPLETION in "${HOMEBREW_PREFIX}/etc/bash_completion.d/"*
    do
      [[ -r "${COMPLETION}" ]] && source "${COMPLETION}"
    done
  fi
else
  source ~/.config/git/git-completion.bash
  source ~/.config/git/git-prompt.sh
  source ~/.config/z/z.sh
fi

_timer_start() {
  _cmd_timer=${_cmd_timer:-$SECONDS}
}

_timer_stop() {
  local elapsed=$(( SECONDS - ${_cmd_timer:-$SECONDS} ))
  _cmd_elapsed=""
  (( elapsed > 0 )) && _cmd_elapsed=" [${elapsed}s]"
  unset _cmd_timer
}

trap '_timer_start' DEBUG
PROMPT_COMMAND='_timer_stop'

GIT_PS1_SHOWDIRTYSTATE=true
PS1='\[\033[0m\]:\[\033[35m\]\w \[\033[31m\]$(__git_ps1)\[\033[33m\]${_cmd_elapsed}\[\033[36m\] \t\n\[\033[0m\]$ '

alias reload='exec $SHELL -l'
alias lzd='lazydocker'
alias k='kubectl'
alias v='nvim'
alias zz='_zfz'
alias zh='_zhz'

export PATH="/usr/local/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

eval "$(direnv hook bash)"
eval "$(fzf --bash)"
